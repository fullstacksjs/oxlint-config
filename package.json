{
  "name": "@fullstacksjs/oxlint-config-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "FullstacksJS OXLint Config workspace root",
  "homepage": "https://github.com/fullstacksjs/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/fullstacksjs/oxlint-config/issues"
  },
  "license": "MIT",
  "author": "FullstacksJS <fullstacksjs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstacksjs/oxlint-config.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "test": "vp run -r test",
    "check": "vp check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@fullstacksjs/oxlint-minimal": "workspace:*",
    "@types/node": "catalog:",
    "bumpp": "12.1.1",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    }
  },
  "inlinedDependencies": {
    "oxlint": "catalog:"
  }
}
