{
  "name": "@fullstacksjs/oxlint-minimal",
  "version": "0.0.0",
  "description": "FullstacksJS OXLint Config Minimal",
  "homepage": "https://github.com/fullstacksjs/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/fullstacksjs/oxlint-config/issues"
  },
  "license": "MIT",
  "author": "FullstacksJS <fullstacksjs@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstacksjs/oxlint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "generate:fixtures": "node --experimental-transform-types scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "eslint-plugin-regexp": "3.1.1",
    "local-pkg": "1.2.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    }
  },
  "inlinedDependencies": {
    "oxlint": "catalog:"
  }
}
