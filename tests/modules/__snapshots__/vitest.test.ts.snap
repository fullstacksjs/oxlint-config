// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`vitest > should lint 'vitest/consistent-vitest-vi' 1`] = `
[
  {
    "column": 1,
    "line": 3,
    "message": "The vitest function accessor used is not allowed",
    "rule": "vitest(consistent-vitest-vi)",
    "severity": "warning",
  },
]
`;

exports[`vitest > should lint 'vitest/no-conditional-tests' 1`] = `[]`;

exports[`vitest > should lint 'vitest/no-import-node-test' 1`] = `
[
  {
    "column": 22,
    "line": 3,
    "message": "Do not import from \`node:test\`",
    "rule": "vitest(no-import-node-test)",
    "severity": "error",
  },
  {
    "column": 3,
    "line": 7,
    "message": "\`expect\` must be inside of a test block.",
    "rule": "vitest(no-standalone-expect)",
    "severity": "warning",
  },
]
`;

exports[`vitest > should lint 'vitest/prefer-called-once' 1`] = `[]`;

exports[`vitest > should lint 'vitest/prefer-to-be-object' 1`] = `[]`;

exports[`vitest > should lint 'vitest/require-local-test-context-for…' 1`] = `
[
  {
    "column": 5,
    "line": 8,
    "message": "Enforce \`test\` and \`it\` usage conventions",
    "rule": "vitest(consistent-test-it)",
    "severity": "warning",
  },
]
`;

exports[`vitest > should lint 'vitest/valid-describe-callback' 1`] = `[]`;

exports[`vitest > should lint 'vitest/warn-todo' 1`] = `
[
  {
    "column": 1,
    "line": 4,
    "message": "Enforce \`test\` and \`it\` usage conventions",
